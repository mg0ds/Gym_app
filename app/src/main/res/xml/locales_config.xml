<?xml version="1.0" encoding="utf-8"?>
<!--
  Języki, między którymi użytkownik może wybierać na ekranie języka aplikacji
  (Android 13+, `android:localeConfig` w manifeście). Polska jest językiem
  domyślnym zasobów, angielski ma własny katalog `values-en`.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="pl" />
    <locale android:name="en" />
</locale-config>
