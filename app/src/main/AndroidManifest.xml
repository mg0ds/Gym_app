<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Timer treningu działa jako usługa pierwszoplanowa, żeby notyfikacja
      z czasem treningu została widoczna przy zgaszonym ekranie. Typ
      "specialUse" jest dla funkcji, które nie pasują do gotowych kategorii
      (użytkownik sam pilnuje swojego treningu), a POST_NOTIFICATIONS pozwala
      pokazać tę notyfikację na Androidzie 13+.

      Koniec przerwy pilnuje budzik systemowy (AlarmManager), bo tylko on obudzi
      telefon przy zgaszonym ekranie. SCHEDULE_EXACT_ALARM pozwala odmierzyć go
      co do sekundy, gdy użytkownik zgodzi się na "Alarmy i przypomnienia";
      bez zgody przerwa kończy się z dokładnością, na jaką pozwala system.
      VIBRATE jest potrzebne, żeby koniec przerwy dał się poczuć, nie tylko
      usłyszeć.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Backup Androida jest wyłączony świadomie. Auto Backup (allowBackup="true")
      wysyła bazę i preferencje do konta Google, co kłóci się z obietnicą
      "wszystkie dane zostają na urządzeniu" (ekran "O aplikacji"), a własna
      kopia ZIP z M9 i tak przenosi dane na nowe urządzenie. Włączone
      `dataExtractionRules`/`fullBackupContent` tylko udawałyby kontrolę nad
      tym, co i tak jedzie do chmury (dataExtractionRules działa od API 31,
      a pełnego backupu pilnuje osobny fullBackupContent dla starszych wersji -
      dwa pliki, żeby powiedzieć "nic"). Lint słusznie dopomina się przy tym
      o `dataExtractionRules`, ale przy wyłączonym backupie ten plik nie ma
      czego ograniczać, stąd jawny `tools:ignore` zamiast pustych reguł.
    -->
    <application
        android:name=".GymTrackerApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymTracker"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GymTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          stopWithTask="false": schowanie aplikacji z listy ostatnich zadań nie
          może zgasić notyfikacji z treningiem - przerwanie treningu ma być
          świadomą decyzją, a nie skutkiem sprzątania ekranu.
        -->
        <service
            android:name=".timer.WorkoutTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout_timer"
                tools:targetApi="31" />
        </service>

        <!--
          Budzik końca przerwy. Nie jest eksportowany: budzi go wyłącznie
          PendingIntent utworzony przez aplikację, więc żaden inny proces nie
          może nam wstrzyknąć "końca przerwy".
        -->
        <receiver
            android:name=".timer.RestAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
