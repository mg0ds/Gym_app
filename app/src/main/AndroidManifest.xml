<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Timer treningu działa jako usługa pierwszoplanowa, żeby notyfikacja
      z czasem treningu została widoczna przy zgaszonym ekranie. Typ
      "specialUse" jest dla funkcji, które nie pasują do gotowych kategorii
      (użytkownik sam pilnuje swojego treningu), a POST_NOTIFICATIONS pozwala
      pokazać tę notyfikację na Androidzie 13+.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GymTrackerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GymTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          stopWithTask="false": schowanie aplikacji z listy ostatnich zadań nie
          może zgasić notyfikacji z treningiem - przerwanie treningu ma być
          świadomą decyzją, a nie skutkiem sprzątania ekranu.
        -->
        <service
            android:name=".timer.WorkoutTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout_timer"
                tools:targetApi="31" />
        </service>
    </application>

</manifest>
